# MongoDB Connection String (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/preppilot

# Port (defaults to 3000 if omitted)
PORT=3000

# Secret key for signing JWT tokens
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL for CORS (e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-app.vercel.app

# Optional extra comma-separated origins
# ALLOWED_ORIGINS=https://preview.vercel.app,https://mycustomdomain.com

# Google Gemini API Keys (can provide one or more for rotation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY1=your_gemini_api_key_1_here
GEMINI_API_KEY2=your_gemini_api_key_2_here
GEMINI_API_KEY3=your_gemini_api_key_3_here
